{
  "name": "Programme",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "What this programme is called."
    },
    "mode": {
      "type": "string",
      "enum": [
        "machine",
        "quiet"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "machine",
      "description": "Machine kit or quiet kit for every night it carries."
    },
    "weeks": {
      "type": "integer",
      "minimum": 1,
      "description": "How many weeks the programme runs. Built programmes use 4, 8 or 12."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "The first night's date."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "complete",
        "abandoned"
      ],
      "enumColors": [
        "gray",
        "green",
        "blue",
        "red"
      ],
      "default": "draft",
      "description": "Only one programme is active at a time."
    },
    "note": {
      "type": "string",
      "format": "textarea",
      "description": "What this block of weeks is for."
    },
    "source": {
      "type": "string",
      "enum": [
        "built",
        "imported"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "built",
      "description": "Whether the nights came from the builder or from pasted text."
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the pasted text was imported."
    },
    "raw_text": {
      "type": "string",
      "format": "textarea",
      "description": "The pasted plan, kept so it can be exported and re-imported."
    }
  },
  "required": [
    "name",
    "mode",
    "weeks",
    "start_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}