{
  "name": "CheckIn",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "format": "relation",
      "description": "Session id this check-in belongs to."
    },
    "elapsed_min": {
      "type": "integer",
      "minimum": 0,
      "description": "Minutes elapsed in the session at this check-in."
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "description": "Round number at this check-in."
    },
    "edge_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Edge number within a denial or quiet session, counted from the previous edge."
    },
    "wand_intensity": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "enumColors": [
        "blue",
        "blue",
        "green",
        "yellow",
        "red"
      ],
      "description": "Wand intensity used at this edge, 1 to 5."
    },
    "intensity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Quiet kit: intensity used at this check-in, 1 to 5."
    },
    "pace": {
      "type": "string",
      "enum": [
        "slow",
        "normal",
        "fast"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow"
      ],
      "description": "Quiet kit: pace used at this check-in."
    },
    "held_sec": {
      "type": "integer",
      "minimum": 0,
      "description": "Quiet kit: seconds the edge was held."
    },
    "finished": {
      "type": "boolean",
      "default": false,
      "description": "Quiet kit: the session was finished on this check-in."
    },
    "toys_active": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "stretcher",
          "prostate_plug",
          "wand",
          "glans_cap",
          "pocket_pussy",
          "sound",
          "cock_ring",
          "wedge",
          "spreader_bar",
          "restraints",
          "blindfold"
        ]
      },
      "description": "Kit still on at this check-in. Defaults to the session kit."
    },
    "ruined": {
      "type": "boolean",
      "default": false,
      "description": "Whether the edge was ruined. Each ruin takes one off the session target."
    },
    "forced": {
      "type": "boolean",
      "default": false,
      "description": "Whether the ruin was taken deliberately. A forced ruin implies ruined."
    },
    "missed_count": {
      "type": "boolean",
      "default": false,
      "description": "Whether the count was missed on this edge. The next edge holds longer."
    },
    "suction": {
      "type": "string",
      "enum": [
        "off",
        "very_low",
        "low",
        "mid",
        "high"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green",
        "yellow",
        "red"
      ],
      "description": "Suction level at the check-in."
    },
    "cycle": {
      "type": "string",
      "enum": [
        "slow",
        "normal",
        "fast"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow"
      ],
      "description": "Cycle pace at the check-in."
    },
    "stated_condition": {
      "type": "string",
      "enum": [
        "fine",
        "puffy",
        "tight_numb",
        "raw"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "purple"
      ],
      "description": "Condition as stated by the user."
    },
    "effective_severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Severity after mapping the stated condition and signals, 0 to 3."
    },
    "closeness": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "How close to the limit the user feels, 1 to 10."
    },
    "photo_burst": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "description": "Up to three photos taken at the check-in."
    },
    "inspector_severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Severity read from the photos, 0 to 3."
    },
    "redness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Redness read from the photos, 0 to 3."
    },
    "seal_quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Seal quality read from the photos, 0 to 3."
    },
    "inspector_note": {
      "type": "string",
      "format": "text",
      "description": "Short note from the photo inspection."
    },
    "felt_text": {
      "type": "string",
      "format": "textarea",
      "description": "What the user felt, in their own words."
    },
    "call_issued": {
      "type": "string",
      "enum": [
        "continue",
        "hold",
        "drop",
        "break",
        "end",
        "log_ruin",
        "hold_then_stop",
        "hold_longer",
        "dead_stop",
        "re_drive",
        "remove_stretcher",
        "swap_to_traditional"
      ],
      "enumColors": [
        "green",
        "yellow",
        "yellow",
        "blue",
        "red",
        "purple",
        "yellow",
        "yellow",
        "red",
        "yellow",
        "yellow",
        "purple"
      ],
      "description": "The call made at this check-in."
    },
    "call_reason": {
      "type": "string",
      "format": "text",
      "description": "Why that call was made."
    },
    "break_minutes": {
      "type": "integer",
      "minimum": 0,
      "description": "Break length in minutes, if a break was called."
    },
    "overridden": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user overrode the issued call."
    },
    "override_note": {
      "type": "string",
      "format": "text",
      "description": "What the override was and why."
    },
    "overridden_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call was overridden. Set once on the override and cleared if it is taken back."
    },
    "is_dry": {
      "type": "boolean",
      "default": false,
      "description": "Whether this round was dry."
    },
    "unsynced": {
      "type": "boolean",
      "default": false,
      "description": "Whether the call was decided on the device and still needs the server to confirm it."
    },
    "commentary": {
      "type": "string",
      "format": "textarea",
      "description": "Mistress commentary on this check-in, written by the agent only."
    }
  },
  "required": [
    "session",
    "elapsed_min"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}