{
  "name": "Session",
  "type": "object",
  "properties": {
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "When the session started."
    },
    "mode": {
      "type": "string",
      "enum": [
        "machine",
        "quiet"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "machine",
      "description": "Machine kit with suction, or quiet kit by hand."
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "full",
        "forced",
        "payoff",
        "denial"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "pink"
      ],
      "description": "Which plan the session follows."
    },
    "block": {
      "type": "string",
      "format": "relation",
      "description": "Block this session counts towards."
    },
    "receivers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "front",
          "back",
          "mouth"
        ]
      },
      "description": "What the session was taken on, picked at setup."
    },
    "planned_build_min": {
      "type": "integer",
      "minimum": 0,
      "description": "Planned build duration in minutes."
    },
    "start_intensity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Quiet kit: intensity at the start of the session, 1 to 5."
    },
    "target_edges": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "Quiet kit: edges the session runs to."
    },
    "edges_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Quiet kit: edges taken so far."
    },
    "ruin_target_round": {
      "type": "integer",
      "minimum": 1,
      "description": "The round the ruin is scheduled for. Unset means no forced ruin is planned."
    },
    "forced_ruin_done": {
      "type": "boolean",
      "default": false,
      "description": "Whether the forced ruin has already been taken this session."
    },
    "toys": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "stretcher",
          "prostate_plug",
          "wand",
          "glans_cap",
          "pocket_pussy",
          "sound",
          "cock_ring",
          "wedge",
          "spreader_bar",
          "restraints",
          "blindfold"
        ]
      },
      "description": "The kit confirmed for this session."
    },
    "kit_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the kit was ticked and confirmed before the session started."
    },
    "stretcher_remove_at_min": {
      "type": "integer",
      "minimum": 0,
      "description": "Elapsed minutes at which the stretcher comes off. Unset means no removal point."
    },
    "constriction": {
      "type": "string",
      "enum": [
        "traditional",
        "constriction"
      ],
      "enumColors": [
        "gray",
        "yellow"
      ],
      "description": "Constriction approach for the session."
    },
    "start_suction": {
      "type": "string",
      "description": "Suction level at the start of the session."
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "break",
        "ended"
      ],
      "enumColors": [
        "gray",
        "green",
        "yellow",
        "blue"
      ],
      "default": "planned",
      "description": "Where the session stands right now."
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the session ended."
    },
    "break_ends": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date-time"
      },
      "description": "When each break taken in this session ends; the last entry is the current one."
    },
    "rounds_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total rounds completed."
    },
    "breaks_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total breaks taken."
    },
    "dry_rounds": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of rounds marked dry."
    },
    "peak_elapsed_min": {
      "type": "integer",
      "minimum": 0,
      "description": "Elapsed minutes at the peak point of the session."
    },
    "projected_end_min": {
      "type": "integer",
      "minimum": 0,
      "description": "Projected end time in elapsed minutes."
    },
    "briefing": {
      "type": "string",
      "format": "textarea",
      "description": "The briefing written before the session."
    },
    "debrief": {
      "type": "string",
      "format": "textarea",
      "description": "The debrief written after the session."
    },
    "best_moment": {
      "type": "string",
      "format": "textarea",
      "description": "Debrief: the best moment of the session."
    },
    "where_turned": {
      "type": "string",
      "format": "textarea",
      "description": "Debrief: where the session turned."
    },
    "would_change": {
      "type": "string",
      "format": "textarea",
      "description": "Debrief: what would be changed next time."
    },
    "would_repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Would repeat rating, 1 to 5."
    },
    "head_next_day": {
      "type": "string",
      "enum": [
        "fine",
        "puffy",
        "tight_numb",
        "raw",
        "unknown"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "purple",
        "gray"
      ],
      "default": "unknown",
      "description": "Head condition the next day."
    },
    "follow_up_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the eighteen hour follow-up has already been raised for this session."
    },
    "stats": {
      "type": "object",
      "description": "Computed at the end of the session: elapsed, check-ins, rounds, breaks, first break, max severity, average round gap.",
      "additionalProperties": true
    },
    "analysis": {
      "type": "string",
      "format": "textarea",
      "description": "Cross-session reading of break triggers and the plateau trend, written after the debrief is saved."
    },
    "analysis_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cross-session analysis was last written."
    }
  },
  "required": [
    "start_time",
    "plan_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}