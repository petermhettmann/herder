{
  "name": "Session End Stats",
  "description": "When a session ends, its stats are computed and the debrief unlocks.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Session",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"ended\" and .trigger.old_data.status != \"ended\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "session_end_stats",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "compute_stats": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/workflows/end-stats",
            "method": "POST",
            "body": {
              "sessionId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Compute the stats",
            "description": "Elapsed, breaks, plateau"
          }
        }
      }
    ]
  }
}