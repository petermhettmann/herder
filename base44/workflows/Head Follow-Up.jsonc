{
  "name": "Head Follow-Up",
  "description": "Eighteen hours after a session ends, ask for the next-day head condition.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "head_follow_up",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_ended": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/workflows/head-followup",
            "method": "POST",
            "body": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Ask for the head condition",
            "description": "Ended eighteen hours ago"
          }
        }
      }
    ]
  }
}