{
  "name": "Round Check-In",
  "description": "Ninety seconds after a round is logged, a check-in is forced unless one has landed.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "CheckIn"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "round_check_in",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "wait_for_check_in": {
          "wait": "PT90S",
          "then": "force_check_in",
          "x-base44": {
            "title": "Wait ninety seconds",
            "description": "Give the check-in its window"
          }
        }
      },
      {
        "force_check_in": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/workflows/round",
            "method": "POST",
            "body": {
              "checkInId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Force the check-in",
            "description": "Skipped if one already landed"
          }
        }
      }
    ]
  }
}