{
  "name": "Debrief Analysis",
  "description": "When a debrief is saved, this session is read against the recent record for break triggers and the plateau trend.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Session",
      "events": [
        "update"
      ]
    },
    "condition": "${ (.trigger.data.debrief // \"\") != \"\" and .trigger.data.debrief != (.trigger.old_data.debrief // \"\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "debrief_analysis",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "read_record": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/workflows/debrief-analysis",
            "method": "POST",
            "body": {
              "sessionId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Read across sessions",
            "description": "Break triggers and plateau"
          }
        }
      }
    ]
  }
}